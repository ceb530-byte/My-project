# PlotPulse environment variables

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-32-char-string-minimum

# Database (SQLite local dev; use Postgres in production — see docker-compose.yml)
DATABASE_URL="file:./prisma/dev.db"

# Clerk auth (optional — dev session auth used when unset)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/onboarding

# Stripe billing (optional — mock checkout when unset)
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# EPC Open Data (optional — register at https://epc.opendatacommunities.org)
EPC_API_EMAIL=
EPC_API_KEY=

# Council tax via Homedata (optional — https://homedata.co.uk/council-tax-api)
HOMEDATA_API_KEY=

# Email alerts via Resend (optional — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=PlotPulse <alerts@plotpulse.app>

# Cron secret for alert digest job (protect /api/cron/alerts)
CRON_SECRET=change-me-for-production

# OpenAI moderation (optional — rule-based moderation used when unset)
OPENAI_API_KEY=
